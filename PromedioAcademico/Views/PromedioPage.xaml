<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PromedioAcademico.Views.PromedioPage">
    <VerticalStackLayout Padding="20" Spacing="10">
        <Entry Placeholder="Calificación 1" Text="{Binding Cal1}" />
        <Entry Placeholder="Calificación 2" Text="{Binding Cal2}" />
        <Entry Placeholder="Calificación 3" Text="{Binding Cal3}" />
        <Button Text="Calcular promedio" Command="{Binding CalcularCommand}" />
        <Label Text="{Binding Mensaje}" TextColor="Red" />          
        <Label Text="{Binding Promedio}" />     
        <Label Text="{Binding Nivel}" />
    </VerticalStackLayout>
</ContentPage>      